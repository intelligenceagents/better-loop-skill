{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["packages/contracts/src/**/*.ts", "packages/core/src/**/*.ts", "packages/adapters/src/**/*.ts", "packages/cli/src/**/*.ts", "packages/privacy/src/**/*.ts", "tests/**/*.ts", "tools/**/*.ts"]
}
