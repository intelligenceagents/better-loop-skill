{
  "name": "@better-loop/handoff",
  "version": "0.1.0-draft.2",
  "description": "Explicit loopback-to-browser handoff of an exact minimized Better Loop approval.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./browser": {
      "import": { "types": "./dist/browser.d.ts", "default": "./dist/browser.js" },
      "require": { "types": "./dist/browser.d.cts", "default": "./dist/browser.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "dependencies": {
    "@better-loop/contracts": "0.1.0-draft.1",
    "@better-loop/evidence": "0.1.0-draft.2"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "node --import tsx --test test/browser.spec.ts",
    "test:consumer": "node --import tsx test/consumer.ts",
    "check": "npm run build && npm run typecheck && npm test && npm run test:browser && npm run test:consumer"
  }
}
