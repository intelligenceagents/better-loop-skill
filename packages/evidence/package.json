{
  "name": "@better-loop/evidence",
  "version": "0.1.0-draft.2",
  "description": "Minimized capability evidence, exact purpose binding and fail-closed contribution preparation.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "dependencies": {
    "@better-loop/contracts": "0.1.0-draft.1",
    "@better-loop/privacy": "0.1.0-draft.3"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "check": "npm run build && npm run typecheck && npm test"
  }
}
