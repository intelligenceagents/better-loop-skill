{
  "name": "@better-loop/measurement",
  "version": "0.1.0-draft.1",
  "description": "Local, host-neutral paired measurement. Descriptive results are not person rankings.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "bin": { "better-loop-measure": "./dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run build && npm run typecheck && npm test"
  }
}
