{
  "name": "@better-loop/privacy",
  "version": "0.1.0-draft.3",
  "description": "Local minimized-candidate scanning, review and exact-consent preparation. No upload transport.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "dependencies": { "@better-loop/contracts": "0.1.0-draft.1" },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --import tsx --test test/*.test.ts"
  }
}
