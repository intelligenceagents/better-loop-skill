{
  "name": "@better-loop/contracts",
  "version": "0.1.0-draft.1",
  "description": "Draft Better Loop JSON contracts and local consent canonicalization. Validation is not privacy clearance.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./schemas/share-candidate.schema.json": "./schemas/share-candidate.schema.json",
    "./schemas/evaluation-run.schema.json": "./schemas/evaluation-run.schema.json",
    "./package.json": "./package.json"
  },
  "bin": { "better-loop-contracts": "./dist/cli.js" },
  "files": ["dist", "schemas", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "sideEffects": false
}
